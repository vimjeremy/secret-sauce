# desktop portals
exec /usr/libexec/xdg-desktop-portal-gtk -r
exec /usr/libexec/xdg-desktop-portal-wlr -r
exec /usr/libexec/flatpak-portal -r
exec "sh -c 'sleep 5;exec /usr/libexec/xdg-desktop-portal -r'"

# apps
exec_always autotiling
exec_always pipewire
exec_always mako

focus_follows_mouse no
font pango:Iosevka 16
set $mod Mod4

set $term kitty
set $menu 'rofi -show drun -font "Iosevka 16"'
set $browser 'chromium'
set $volume 'kitty --class wiremix -o remember_window_size=no -o initial_window_width=85c -o initial_window_height=21c wiremix'
set $screenshot 'grim -g "$(slurp -w 0)" - | swappy -f -'

seat * xcursor_theme BreezeX-Black 24
output * mode 2560x1440@360Hz
output * bg "~/.config/sway/wallpapers/cat.png" fill
input type:keyboard {
    xkb_layout "pl"
    repeat_rate 30
    repeat_delay 200
}

#
### Key bindings
#
    # Launch programs
    bindsym $mod+Return exec $term
		bindsym $mod+b exec $browser
		bindsym $mod+e exec $files
		bindsym $mod+v exec $volume
    bindsym $mod+Space exec $menu
    bindsym $mod+Shift+s exec $screenshot

    # Maintenance
    bindsym $mod+Shift+r reload
    bindsym $mod+Shift+e exec 'swaymsg exit'

    # Move your focus around
    bindsym $mod+h focus left
    bindsym $mod+j focus down
    bindsym $mod+k focus up
    bindsym $mod+l focus right

    bindsym $mod+Shift+h move left
    bindsym $mod+Shift+j move down
    bindsym $mod+Shift+k move up
    bindsym $mod+Shift+l move right

    # Workspaces & windows
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+q kill

    # Layouts
    bindsym $mod+Shift+t layout tabbed
    bindsym $mod+t layout toggle split
    bindsym $mod+f fullscreen
    bindsym $mod+Shift+space floating toggle
    floating_modifier $mod normal

default_border none
default_floating_border none
gaps inner 6
gaps outer 2

bar {
    position bottom
    status_command while date +'%I:%M  '; do sleep 1; done

    # kape colorscheme
    colors {
        background #181616
        statusline #d4be98
        separator  #2e2a2a

        #                  border    background text
        focused_workspace  #181616   #181616    #e7bb5c
        active_workspace   #181616   #181616    #d4be98
        inactive_workspace #181616   #181616    #c2c2c2
        urgent_workspace   #181616   #181616    #b53535
        binding_mode       #181616   #181616    #c87941
    }
}

include /etc/sway/config.d/*
for_window [app_id="wiremix"] floating enable, move position center
